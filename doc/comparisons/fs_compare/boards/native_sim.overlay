/*
 * native_sim shaped like the nRF5340-DK's MX25R6435F (64 KB erase blocks,
 * 4 B write alignment; see app_perf_l0/geometry/mx25r64.overlay), with the
 * 8 MB the DK gives the stack split into two 4 MB partitions: one for
 * blob_db (UBI or flash_area) and one for littlefs. A variant uses one or
 * both; each stack gets the same 4 MB.
 */

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
	erase-block-size = <65536>;
	write-block-size = <4>;
};

&storage_partition {
	reg = <0x00800000 DT_SIZE_M(4)>;
};

&flash0 {
	partitions {
		lfs_partition: partition@c00000 {
			compatible = "zephyr,mapped-partition";
			label = "lfs";
			reg = <0x00c00000 DT_SIZE_M(4)>;
		};
	};
};
