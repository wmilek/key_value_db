/*
 * Same partition move as the demo app: run the benchmark against the on-board
 * MX25R64 QSPI NOR (8 MB, 64 KB sectors) so the numbers reflect real flash.
 */

/delete-node/ &storage_partition;

&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			compatible = "kvdb,ubi";
			label = "storage";
			reg = <0x00000000 0x00800000>;

			volumes {
				blobdb_vol: ubi-volume-blobdb {
					volname = "blobdb";
				};
			};
		};
	};
};

/*
 * The blob_db store on the volume above. No "automount": this program mounts,
 * formats and unmounts the store itself, which keeps working exactly as
 * before (doc/proposals/2026-10-12-devicetree-configuration.md §3.5).
 */
/ {
	chosen {
		kvdb,blob-db = &blobdb0;
	};

	blobdb0: blob-db {
		compatible = "kvdb,blob-db";
		storage = <&blobdb_vol>;
	};
};
