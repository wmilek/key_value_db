/*
 * Same 16 MB sim-flash / 8 MB storage_partition layout as the rest of the
 * repository, so the sample runs on the geometry the tests and benchmarks use.
 */

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
};

&storage_partition {
	/* A UBI device with one volume, which blob_db lives on. Keep
	 * "zephyr,mapped-partition": it is what makes the node a partition on
	 * native_sim.
	 */
	compatible = "kvdb,ubi", "zephyr,mapped-partition";
	reg = <0x00800000 DT_SIZE_M(8)>;

	volumes {
		blobdb_vol: ubi-volume-blobdb {
			volname = "blobdb";
		};
	};
};

/*
 * The blob_db store on the volume above. No "automount", on purpose: the
 * sample shows the store mounting itself on the first call that needs it.
 */
/ {
	chosen {
		kvdb,blob-db = &blobdb0;
	};

	blobdb0: blob-db {
		compatible = "kvdb,blob-db";
		storage = <&blobdb_vol>;
	};
};
