/*
 * Move blob_db's storage_partition off the app-core internal NVMC (32 KB
 * at 0xf8000) and onto the on-board MX25R64 QSPI NOR (8 MB). Matches the
 * 8 MB partition the native_sim overlay carves out, so tests and device
 * exercise the same geometry.
 */

/delete-node/ &storage_partition;

&mx25r64 {
	/*
	 * The MX25R's power-on ultra-low-power mode corrupts reads after dense
	 * read sequences (key_value_db PR #44). Needs the nrf_qspi_nor patch in
	 * zephyr/patches.yml (`west patch apply`); without it this is ignored.
	 */
	mxicy,mx25r-power-mode = "high-performance";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			label = "storage";
			reg = <0x00000000 0x00800000>;
		};
	};
};
