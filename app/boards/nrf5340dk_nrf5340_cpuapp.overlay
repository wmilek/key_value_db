/*
 * Move blob_db's storage_partition off the app-core internal NVMC (32 KB
 * at 0xf8000) and onto the on-board MX25R64 QSPI NOR (8 MB). Matches the
 * 8 MB partition the native_sim overlay carves out, so tests and device
 * exercise the same geometry.
 */

/delete-node/ &storage_partition;

&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			compatible = "kvdb,ubi";
			label = "storage";
			reg = <0x00000000 0x00800000>;

			volumes {
				blobdb_vol: ubi-volume-blobdb {
					volname = "blobdb";
				};
			};
		};
	};
};

/*
 * The blob_db store on the volume above, mounted before main() runs.
 */
/ {
	chosen {
		kvdb,blob-db = &blobdb0;
	};

	blobdb0: blob-db {
		compatible = "kvdb,blob-db";
		storage = <&blobdb_vol>;
		automount;
	};
};
