+			(void)tr_read(g_fa, 0x470080, sm, 16);
+			printk("EMU7 boot after 0x%x/%u: byte4=%02x\n", pre[i].a, pre[i].l, sm[4]);
+		}
+	}
+	if (EMU_MODE == 6) {
+		static const struct { uint32_t off; uint16_t len; } rp[] = {
+			{0x130700, 12}, {0x130798, 12}, {0x130830, 12}, {0x1308c8, 12},
+			{0x130960, 12}, {0x1309f8, 12}, {0x130a28, 12}, {0x130ac0, 12},
+			{0x130b58, 12}, {0x130ba8, 12}, {0x130c18, 12}, {0x130c88, 12},
+			{0x130d18, 12}, {0x130acc, 136}, {0x130b54, 2}, {0x6e0080, 16},
+			{0x6e0090, 12}, {0x6e00c0, 12}, {0x6e00f0, 12}, {0x6e0140, 12},
+			{0x6e0190, 12}, {0x6e0200, 12}, {0x6e00fc, 64}, {0x6e013c, 2},
+		};
+		static const unsigned int starts[] = { 0, 15, 22, 23, 24, 0 };
+		static uint8_t big[136] __aligned(4);
+		uint8_t sm[16] __aligned(4);
+
+		for (unsigned int v = 0; v < ARRAY_SIZE(starts); v++) {
+			for (unsigned int i = starts[v]; i < ARRAY_SIZE(rp); i++) {
+				uint8_t *d = rp[i].len > 16 ? big : sm;
+
+				(void)tr_read(g_fa, rp[i].off, d + (rp[i].len == 2 ? 2 : 0),
+						      rp[i].len);
+			}
+			(void)tr_read(g_fa, 0x470080, sm, 16);
+			printk("EMU6 replay from %u: byte4=%02x crc=%02x%02x%02x%02x\n", starts[v],
+			       sm[4], sm[12], sm[13], sm[14], sm[15]);
+		}
+	}
+	if (EMU_MODE == 5) {
+		static const off_t probe[] = { 0x470080, 0x370080, 0x470080, 0x370080 };
+
+		for (unsigned int i = 0; i < ARRAY_SIZE(probe); i++) {
+			uint8_t pb[16] __aligned(4);
+
+			(void)tr_read(g_fa, probe[i], pb, sizeof(pb));
+			printk("EMU5 boot probe 0x%lx: %02x %02x %02x %02x %02x .. %02x %02x %02x %02x\n",
+			       (long)probe[i], pb[0], pb[1], pb[2], pb[3], pb[4], pb[12], pb[13],
+			       pb[14], pb[15]);
+		}
+	}
+	g_peb_size = peb_size - EMU_HDR;
+	geom->peb_size = g_peb_size;
 	geom->write_align = write_align;
-	geom->n_pebs = (uint16_t)(fa_size / peb_size);
+	geom->n_pebs = 121;
+	printk("EMU geometry: leb %zu, %u lebs, +%d\n", g_peb_size, geom->n_pebs, EMU_HDR);
