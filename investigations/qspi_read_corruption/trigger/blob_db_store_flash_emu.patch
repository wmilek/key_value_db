 static const struct flash_area *g_fa;
 static size_t g_peb_size;
 
+/* EXPERIMENT: mimic UBI's geometry - data starts 128 B into each sector,
+ * logical block n lives in sector n, 121 logical blocks. */
+#define EMU_HDR 128
+#ifndef EMU_MODE
+#define EMU_MODE 0
+#endif
+#ifndef EMU_SHIFT
+#define EMU_SHIFT 0
+#endif
+#ifndef EMU_N
+#define EMU_N 79699
+#endif
+static size_t g_sec_size;
+
+static void ring_put(unsigned int type, off_t off, size_t len);
+
+static int tr_read(const struct flash_area *fa, off_t off, void *dst, size_t len)
+{
+	int rc = flash_area_read(fa, off, dst, len);
+
+	ring_put(0, off, len);
+	if (EMU_MODE == 10) {
+		printk("R%lx %zx\n", (long)off, len);
+	}
+	return rc;
+}
+
+#define RING_N 50000
+static uint8_t ring[RING_N][4];
+static uint32_t ring_cnt;
+static uint16_t lens[255];
+static uint8_t nlens;
+
+/* type: 0 read, 1 write, 2 erase */
+static void ring_put(unsigned int type, off_t off, size_t len)
+{
+	uint8_t li = 0xff;
+
+	if (EMU_MODE != 11) {
+		return;
+	}
+	for (uint8_t i = 0; i < nlens; i++) {
+		if (lens[i] == len) {
+			li = i;
+			break;
+		}
+	}
+	if (li == 0xff && nlens < ARRAY_SIZE(lens)) {
+		lens[nlens] = (uint16_t)len;
+		li = nlens++;
+	}
+	uint8_t *e = ring[ring_cnt % RING_N];
+
+	e[0] = (uint8_t)(((size_t)off >> 16) | (type << 6));
+	e[1] = (uint8_t)(off & 0xff);
+	e[2] = (uint8_t)((off >> 8) & 0xff);
+	e[3] = li;
+	ring_cnt++;
+}
+
+static void ring_dump(void)
+{
+	if (EMU_MODE != 11) {
+		return;
+	}
+	uint32_t first = ring_cnt > RING_N ? ring_cnt - RING_N : 0;
+
+	printk("RINGDUMP total=%u first=%u\n", ring_cnt, first);
+	for (uint32_t i = first; i < ring_cnt; i++) {
+		const uint8_t *e = ring[i % RING_N];
+		const uint32_t a = ((uint32_t)(e[0] & 0x3f) << 16) | ((uint32_t)e[2] << 8) | e[1];
+
+		printk("%c%x %x\n", "RWE?"[e[0] >> 6], a, e[3] == 0xff ? 0 : lens[e[3]]);
+	}
+	printk("RINGEND\n");
+}
+
+static off_t emu(off_t off)
+{
+	const size_t leb = g_sec_size - EMU_HDR;
+
+	return (off_t)(((size_t)off / leb + EMU_SHIFT) * g_sec_size + EMU_HDR + (size_t)off % leb);
+}
+
