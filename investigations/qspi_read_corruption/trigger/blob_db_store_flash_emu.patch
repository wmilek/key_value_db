 {
 	/* No metadata below blob_db's own: nothing to replace. */
@@ -73,10 +158,63 @@ int blob_db_store_open(struct blob_db_store_geom *geom, bool discard)
 		goto err_close;
 	}
 
-	g_peb_size = peb_size;
-	geom->peb_size = peb_size;
+	g_sec_size = peb_size;
+	if (EMU_MODE == 7) {
+		static const struct { uint32_t a; uint16_t l; } pre[] = {
+			{0x400080, 16}, {0x400080, 16}, {0x400090, 12}, {0x400000, 128},
+			{0x400100, 64}, {0x40fff0, 16},
+		};
+		uint8_t sm[16] __aligned(4);
+		static uint8_t big[128] __aligned(4);
+
+		for (unsigned int i = 0; i < ARRAY_SIZE(pre); i++) {
