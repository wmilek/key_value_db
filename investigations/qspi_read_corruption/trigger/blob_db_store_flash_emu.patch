+struct emu_rec {
+	uint32_t off;
+	uint16_t len;
+	uint32_t dst;
+	uint8_t head[8];
+};
+static struct emu_rec hist[24];
+static unsigned int nrd, nbad;
+
 int blob_db_store_read(off_t off, void *buf, size_t len)
 {
 	BLOB_DB_IO_NOTE(BLOB_DB_IO_READ, len);
-	return flash_area_read(g_fa, off, buf, len);
+	off = emu(off);
+
+	/* EXPERIMENT variants, chosen with EMU_MODE at build time. */
+	static uint8_t bnc[1024] __aligned(4);
+	const unsigned int me = nrd + 1;
+	const bool odd = (len % 4) != 0 || ((uintptr_t)buf % 4) != 0;
+	int rc;
+
+	if (EMU_MODE == 7 && ((off >= 0x400000 && off < 0x410000) ||
+			      (off <= 0x470080 && off + (off_t)len > 0x470084))) {
+		printk("EMU7 %u 0x%lx/%zu t=%u\n", me, (long)off, len, k_uptime_get_32());
+	}
+	if (EMU_MODE == 5 && off <= 0x470080 && off + (off_t)len > 0x470084) {
+		static uint8_t p5[16] __aligned(4);
+
+		(void)tr_read(g_fa, 0x470080, p5, sizeof(p5));
+		printk("EMU5 read %u off=0x%lx len=%zu t=%u: byte4=%02x\n", me, (long)off, len,
+		       k_uptime_get_32(), p5[4]);
+	}
+	if ((EMU_MODE == 8 || EMU_MODE == 9) && me == EMU_N) {
+		static const uint32_t a8[] = { 0x480080, 0x470080, 0x480080 };
+		static const uint32_t a9[] = { 0x470080, 0x480080, 0x470080 };
+		static uint8_t x[32] __aligned(4);
+
+		for (unsigned int i = 0; i < 3; i++) {
+			const uint32_t a = EMU_MODE == 8 ? a8[i] : a9[i];
+
+			(void)tr_read(g_fa, a, x, sizeof(x));
+			printk("EMU%d probe %u 0x%06x:", EMU_MODE, i, a);
+			for (size_t j = 0; j < sizeof(x); j++) {
+				printk(" %02x", x[j]);
+			}
+			printk("\n");
+		}
+	}
+	if (EMU_MODE == 1 && me == EMU_N) {
+		printk("EMU1 busy wait before read %u\n", me);
+		k_busy_wait(2000);
+	}
+	if (EMU_MODE == 2 && me == EMU_N) {
+		static uint8_t pre[16] __aligned(4);
+
+		(void)tr_read(g_fa, off, pre, sizeof(pre));
+		printk("EMU2 pre-read %u:", me);
+		for (size_t i = 0; i < sizeof(pre); i++) {
+			printk(" %02x", pre[i]);
+		}
+		printk("\n");
+	}
+	if (((EMU_MODE == 3) || (EMU_MODE == 4 && me == EMU_N - 1)) && odd &&
+	    len <= sizeof(bnc) - 4) {
+		rc = tr_read(g_fa, off & ~3, bnc, ROUND_UP(len + (off & 3), 4));
+		memcpy(buf, bnc + (off & 3), len);
+		if (EMU_MODE == 4) {
+			printk("EMU4 padded read %u off=0x%lx len=%zu\n", me, (long)off, len);
+		}
+	} else {
+		rc = tr_read(g_fa, off, buf, len);
+	}
+
+	/* EXPERIMENT: re-read and compare every read. */
+	static uint8_t chk[256] __aligned(4);
+	static uint8_t chk2[256] __aligned(4);
+	size_t cl = len < sizeof(chk) ? len : sizeof(chk);
+	const uint8_t *b = buf;
+
+	nrd++;
+	if (rc == 0 && tr_read(g_fa, off, chk, cl) == 0 &&
+	    memcmp(chk, b, cl) != 0) {
+		(void)tr_read(g_fa, off, chk2, cl);
+		nbad++;
+		printk("FADBL mismatch #%u (read %u) off=0x%lx len=%zu dst=%p\n",
+		       nbad, nrd, (long)off, len, buf);
+		size_t sl = cl < 32 ? cl : 32;
+
+		printk("  got :");
+		for (size_t i = 0; i < sl; i++) {
+			printk(" %02x", b[i]);
+		}
+		printk("\n  re1 :");
+		for (size_t i = 0; i < sl; i++) {
+			printk(" %02x", chk[i]);
+		}
+		printk("\n  re2 :");
+		for (size_t i = 0; i < sl; i++) {
+			printk(" %02x", chk2[i]);
+		}
+		printk("\n");
+		if (nbad == 1) {
+			ring_dump();
+		}
+		for (unsigned int k = 0; k < ARRAY_SIZE(hist); k++) {
+			const struct emu_rec *h = &hist[(nrd - 1 + k) % ARRAY_SIZE(hist)];
+
+			printk("  h-%02u off=0x%06x len=%u dst=0x%08x head=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+			       ARRAY_SIZE(hist) - k, h->off, h->len, h->dst, h->head[0], h->head[1],
+			       h->head[2], h->head[3], h->head[4], h->head[5], h->head[6], h->head[7]);
+		}
+	}
+	struct emu_rec *r = &hist[nrd % ARRAY_SIZE(hist)];
+
+	r->off = (uint32_t)off;
+	r->len = (uint16_t)len;
+	r->dst = (uint32_t)(uintptr_t)buf;
+	memcpy(r->head, b, len < 8 ? len : 8);
+	if ((nrd % 20000) == 0) {
+		printk("FADBL %u reads, %u mismatches\n", nrd, nbad);
+	}
+	return rc;
 }
 
