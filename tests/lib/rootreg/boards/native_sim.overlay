/*
 * Match the app's overlay: 16 MB sim-flash with an 8 MB storage_partition
 * at offset 0x800000. Required so blob_db sees ≥ 4 sectors and exercises
 * the multi-bucket layout in tests.
 */

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
};

&storage_partition {
	reg = <0x00800000 DT_SIZE_M(8)>;
};
