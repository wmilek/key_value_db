/*
 * Same 8 MB storage_partition of 4 KB sectors as the other blob_db suites, but
 * with a 16-byte write unit, so slot sizes round up past what the unaligned
 * rebind formula assumes.
 */

&flashcontroller0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
};

&flash0 {
	reg = <0x00000000 DT_SIZE_M(16)>;
	write-block-size = <16>;
};

&storage_partition {
	reg = <0x00800000 DT_SIZE_M(8)>;
};
