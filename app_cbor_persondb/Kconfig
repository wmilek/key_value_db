module = APP_CBOR_PERSONDB
module-str = APP_CBOR_PERSONDB
source "subsys/logging/Kconfig.template.log_config"

choice APP_CBOR_PERSONDB_FRONTEND
	prompt "Frontend"
	default APP_CBOR_PERSONDB_FRONTEND_BENCH
	help
	  Both frontends drive the same scenario layer (DESIGN.md §9); they
	  differ only in how the operations are invoked and rendered.

config APP_CBOR_PERSONDB_FRONTEND_BENCH
	bool "Automatic benchmark run"
	help
	  Unattended: open, prepare, fill (resuming in batches), verify,
	  mutate, re-verify, benchmark, report, exit. The source of RESULTS.md.

config APP_CBOR_PERSONDB_FRONTEND_SHELL
	bool "Interactive shell"
	select SHELL
	help
	  The same operations under "persondb <cmd>", for poking a live store
	  on the board — including power-cutting a fill and inspecting what
	  survived.

endchoice

# The shell frontend runs the scenario layer on the SHELL thread, not on main,
# and blob_db builds every slot in a CONFIG_BLOB_DB_MAX_PAYLOAD_LEN + 46 byte
# stack frame (FINDINGS.md B5, job 3). prj.conf sizes CONFIG_MAIN_STACK_SIZE for
# that chain — 19 870 B measured with -fstack-usage — but Zephyr's shell thread
# defaults to 2 048 B, so every persondb command overflowed it and halted the
# system on the first keystroke. Give the shell thread what main gets.
#
# Costs ~26 KB of RAM, and only when the shell frontend is selected.
config SHELL_STACK_SIZE
	default 28672 if APP_CBOR_PERSONDB_FRONTEND_SHELL

config APP_CBOR_PERSONDB_N_PERSONS
	int "Number of persons in the dataset"
	default 8000
	range 8 200000
	help
	  Dataset scale, and a FIXED CONSTANT OF THE BENCHMARK. Two runs are
	  only comparable if they used the same number, so treat changing it
	  as defining a new benchmark rather than tuning this one.

	  8 000 since DESIGN.md §6.5. It was 10 000, chosen once to put the
	  store at roughly half the nRF5340-DK's 8 MiB external flash. The
	  two-instance layout cannot reach that: the measured ceiling is
	  9 670 persons, because kvhash's bucket directory is a 16 384 B blob
	  that blob_db can no longer place once the store is about half full
	  (FINDINGS.md K13).

	  8 000 is the re-sized constant, not the ceiling. The gap is
	  deliberate: 9 670 is where a FRESH fill dies, and a benchmark that
	  sits at its own cliff fails later, on the DK, hours into a fill, for
	  reasons that look random. 17 % under it, the store holds at 41.3 %
	  live across repeated fill/mutate/bench rounds with no drift — that
	  was measured over three consecutive runs, not assumed.

	  The fill percentage remains an output, not a target (DESIGN.md
	  §6.3). If the stack gets more efficient and the same 8 000 persons
	  come to occupy 30 %, that is the improvement being measured — do
	  not raise this to compensate. Raising it to chase the ceiling is
	  how the number stops meaning anything.

	  Lower it for a quick run; the smoke scenario in sample.yaml uses 200.

config APP_CBOR_PERSONDB_PEOPLE_MAPS
	int "Number of person maps"
	default 1
	range 1 64
	help
	  ONE. The application is two kvhash instances — one people map, one
	  credential map — whose roots live in the 'PADB' superblock
	  (DESIGN.md §12). That is the shape the stack intends, and a model
	  application is supposed to be built in it.

	  It was sixteen until DESIGN.md §12.2. Not because the domain has
	  sixteen of anything: a bucket overflows at
	  CONFIG_BLOB_DB_MAX_PAYLOAD_LEN, that was 4 KB, and one map could not
	  hold 10 000 person records without bursting one. Sharding was the way
	  around it. The cap has since moved, one map holds the dataset, and
	  the workaround has to go — it was concealing exactly the kind of
	  limitation this application exists to expose (DESIGN.md §1).

	  Raising this again is a way of hiding K2 and K11 rather than
	  measuring them. If you need it for an experiment, enumerate the
	  population offline first (tools/sizing.py): there is no per-bucket
	  occupancy query to warn you (K10), the bucket count cannot change
	  after create (K3), and the failure is a local -ENOSPC partway
	  through a multi-hour fill.

config APP_CBOR_PERSONDB_FILL_BATCH
	int "Persons per resumable fill batch"
	default 256
	range 1 65536
	help
	  Progress is committed to the superblock after each batch, so an
	  interrupted fill resumes from the last committed count instead of
	  starting over. Replaying a partial batch rewrites identical values,
	  so replay is free.

config APP_CBOR_PERSONDB_VERIFY_SAMPLES
	int "Persons verified per run"
	default 256
	range 1 65536
	help
	  Verifying all 8 000 persons costs roughly 5 minutes per pass on the
	  DK, so a run checks a deterministic spread instead. Every sampled
	  person is compared field by field against the generator, and each of
	  its cards is resolved back through the credential index.

config APP_CBOR_PERSONDB_MUTATE_COUNT
	int "Persons touched per mutation round"
	default 64
	range 1 4096
	help
	  Each run revokes the previous revision's temporary cards and grants
	  the next revision's, exercising both fail-safe orderings
	  (DESIGN.md F5) and proving across a reboot that the previous run's
	  writes survived.

config APP_CBOR_PERSONDB_BENCH_SAMPLES
	int "Operations per benchmark phase"
	default 200
	range 1 65536

config APP_CBOR_PERSONDB_FRESH_START
	bool "Erase the store at boot (start over)"
	help
	  Drop everything before opening, so this run behaves like the very
	  first one. Use once to reset a board that already holds a store; on
	  native_sim prefer the --flash_erase command-line option.

# Sourced last on purpose. Kconfig resolves a symbol's `default` to the first
# one it parses, so any Zephyr default this app overrides — see
# CONFIG_SHELL_STACK_SIZE above — must be stated before this line, not after.
menu "Zephyr"
source "Kconfig.zephyr"
endmenu
