config BLOB_DB
	bool "Stable-id blob storage library"
	select FLASH
	select FLASH_MAP
	select CRC
	help
	  Enable the blob_db library: a stable-id blob store built on
	  Zephyr's flash_area API. See doc/layers/l1_blob_db.md for the on-flash
	  format, atomicity model, and stability contract.

if BLOB_DB

config BLOB_DB_PARTITION_LABEL
	string "Storage partition label"
	default "storage"
	help
	  Label of the fixed flash partition where blobs are stored. Must
	  refer to a fixed-partitions child node in the device tree.

config BLOB_DB_MAX_PAYLOAD_LEN
	int "Max payload length in bytes"
	default 256
	range 1 4096
	help
	  Maximum payload size accepted by blob_db_update. Slot size on flash
	  is bounded by this plus a 14-byte header.

config BLOB_DB_SECTOR_BUF_SIZE
	int "Max flash sector size in bytes"
	default 4096
	range 256 65536
	help
	  Upper bound on the flash sector size blob_db supports. Two buffers
	  of this size live in .bss (single-threaded contract); mount refuses
	  a partition whose sector is larger than this. Set to at least the
	  target flash's largest sector — e.g. 65536 for the mx25r64 QSPI
	  NOR on the nRF5340-DK.

module = BLOB_DB
module-str = BLOB_DB
source "subsys/logging/Kconfig.template.log_config"

endif # BLOB_DB
