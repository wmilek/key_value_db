menu "Containers (L2)"
	depends on BLOB_DB

config BLOB_CONTAINERS_INTENT
	bool "Shared intent helper (named new[] / del[] ids)"
	help
	  Reusable stage->commit->clear intent mechanism (model container §4/§5)
	  shared by the reference-graph mutations of the real containers.

	  NOT YET IMPLEMENTED — skeleton only.

config BLOB_CONTAINER_LOGRING
	bool "logring — bounded per-entry log container"
	select ENTROPY_GENERATOR
	select BLOB_CONTAINER_LOGRING_RANDOM_SOURCE
	help
	  A log-specialized container: a forward-linked chain of per-entry
	  i-nodes with pre-reserved ids, so an append writes one new blob and
	  rewrites nothing. A RAM handle caches the tail; the root is written
	  only at checkpoints (every CHECKPOINT appends), which also carry a
	  waypoint for recovery and batch oldest-first eviction. Reads use an
	  opaque, portable cursor with a per-log epoch that rejects a stale
	  moniker. Scales to near the whole partition. Self-contained on L1.

	  Needs a random source. The per-log epoch is drawn with
	  sys_rand32_get() (the non-crypto random subsystem, not PSA), so the
	  module selects ENTROPY_GENERATOR to pull its own randomness whatever
	  the blob_db backend. That is enough where the board's entropy
	  driver works on its own (native_sim, nRF52). Where it is not —
	  nrf5340dk/nrf5340/cpuapp, whose zephyr,entropy is the
	  Bluetooth HCI RNG and needs the Bluetooth host — there is no
	  sys_rand32_get() and the build stops in Kconfig on
	  BLOB_CONTAINER_LOGRING_RANDOM_SOURCE; see that option for the ways
	  out.

	  The epoch is random, not derived, because its job is to tell a log
	  from the one a reformat put in its place. A reformat restarts
	  blob_db's ids, so anything computed from ids or from a boot-time
	  counter comes out the same and lets a stale moniker through. See
	  doc/layers/l2_containers.md §4.5 and
	  doc/proposals/2026-10-08-logring.md.

config BLOB_CONTAINER_LOGRING_RANDOM_SOURCE
	bool
	depends on ENTROPY_HAS_DRIVER || TEST_RANDOM_GENERATOR || ARM64_RNG
	help
	  Build-time check that sys_rand32_get() exists. It is selected by
	  BLOB_CONTAINER_LOGRING, and its dependency mirrors the one on
	  Zephyr's RNG_GENERATOR_CHOICE (subsys/random/Kconfig): with none of
	  them, Zephyr builds no random generator and logring would fail to
	  link (undefined z_impl_sys_rand_get). Kconfig reports instead that
	  this option "has direct dependencies ... but is currently being
	  y-selected by BLOB_CONTAINER_LOGRING", and Zephyr stops the build.
	  A select, not a "depends on" on BLOB_CONTAINER_LOGRING itself:
	  ENTROPY_HAS_DRIVER is set by drivers that need the ENTROPY_GENERATOR
	  logring selects, which Kconfig rejects as a dependency loop.

	  To satisfy it, enable an entropy driver the board can run
	  (ENTROPY_HAS_DRIVER). On the nRF5340 application core that is the
	  Bluetooth host's HCI RNG (BT=y, which also needs the open-amp module
	  for IPC to the network core; this repository's west.yml does not
	  fetch it), or the PSA RNG of a TF-M build
	  (nrf5340dk/nrf5340/cpuapp/ns). For development only,
	  CONFIG_TEST_RANDOM_GENERATOR=y gives a timer-based generator that is
	  not random: epochs then repeat from boot to boot and stop guarding
	  against a reformat, and Zephyr warns "Not secure symbol
	  TEST_RANDOM_GENERATOR is enabled". A product must not ship with it.

	  On the DK the default UBI backend does not trip this check: PSA
	  Crypto (Mbed TLS) turns on TEST_RANDOM_GENERATOR itself when the
	  board has no entropy driver, so logring gets the same insecure
	  generator. The flash_area backend has no PSA Crypto and stops here.

if BLOB_CONTAINER_LOGRING

config BLOB_CONTAINER_LOGRING_CHECKPOINT
	int "logring checkpoint interval (appends per root write)"
	default 32
	range 1 64
	help
	  Appends between root checkpoints, and the most entries one checkpoint
	  evicts. Larger = fewer root writes (less wear) but a longer open-time
	  walk and a larger retention overshoot (~this many entries). Bounds a
	  stack buffer, so it is capped at 64.

module = BLOB_CONTAINER_LOGRING
module-str = BLOB_CONTAINER_LOGRING
source "subsys/logging/Kconfig.template.log_config"
endif

config BLOB_CONTAINER_SEQ
	bool "seq — append/index sequence container"
	help
	  Sequence shape (seq_ops): file bodies and chunked payloads.
	  NOT YET IMPLEMENTED — skeleton only.

config BLOB_CONTAINER_KVLIST
	bool "kvlist — O(n) map container"
	help
	  Map shape (map_ops) backed by a linear pair list. Smallest map.
	  NOT YET IMPLEMENTED — skeleton only.

config BLOB_CONTAINER_KVHASH
	bool "kvhash — O(1) map container"
	help
	  Map shape (map_ops) backed by a directory of hash buckets, each bucket
	  a packed pair-list blob. Lookups are O(load factor). The geometry —
	  one level, or a directory of sub-directories when one cannot address
	  enough buckets — is derived at create time from the population the
	  caller declares in map_config, and is fixed thereafter.

if BLOB_CONTAINER_KVHASH

config BLOB_CONTAINER_KVHASH_KEY_INLINE_MAX
	int "Longest key stored inside its bucket"
	default 32767
	range 0 32767
	help
	  A key longer than this is written to a blob of its own, and its
	  bucket entry keeps only its length, a 32-bit fingerprint and the
	  blob id (12 B). Lookups compare the fingerprint first and read the
	  key blob only on a match.

	  A write policy, not a format: every entry records where its key
	  lives, and readers go by that record alone. Changing this value
	  changes how new writes are stored; entries written under any
	  earlier value stay readable, and move to the new placement only
	  when their key is next set. Applies to maps created as kvhash v3;
	  v2 maps are never spilled.

	  The default, 32767, never spills. Keys of 12 B or less never gain
	  from spilling.

config BLOB_CONTAINER_KVHASH_VAL_INLINE_MAX
	int "Longest value stored inside its bucket"
	default 32767
	range 0 32767
	help
	  A value longer than this is written to a blob of its own, and its
	  bucket entry keeps only the blob id (8 B). A get of such a value
	  costs one more blob read; a set that keeps its length rewrites
	  only the value blob. A spilled value may exceed one blob_db slot
	  when BLOB_DB_LARGE_PAYLOADS is enabled.

	  Like BLOB_CONTAINER_KVHASH_KEY_INLINE_MAX, a write policy only:
	  it can change between builds, or at run time through
	  kvhash_set_inline_max(), without touching stored data.

	  The default, 32767, never spills.

config BLOB_CONTAINER_KVHASH_TEST_HOOKS
	bool "Test hooks (fingerprint collisions, power cuts)"
	help
	  Exposes kvhash_test_fp_mask, so a test can force key fingerprints
	  to collide, and kvhash_test_cut_after, so it can cut power between
	  any two of kvhash's flash writes. Test builds only.

module = BLOB_CONTAINER_KVHASH
module-str = BLOB_CONTAINER_KVHASH
source "subsys/logging/Kconfig.template.log_config"
endif

config BLOB_CONTAINER_KVTREE
	bool "kvtree — O(log n) ordered map container"
	help
	  Map shape (map_ops) backed by a balanced tree; ordered / range queries.
	  NOT YET IMPLEMENTED — skeleton only.

endmenu
